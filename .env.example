# uk-merchant-categoriser environment template.
# Copy to `.env` and fill in values. NEVER commit a populated `.env`.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
# dev | prod
UKMC_ENV=dev
UKMC_LOG_LEVEL=INFO
# Threshold under which /predict sets requires_review=true
UKMC_CONFIDENCE_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite is the local default. For PostgreSQL set, for example:
# UKMC_DATABASE_URL=postgresql+psycopg://ukmc:ukmc@localhost:5432/ukmc
UKMC_DATABASE_URL=sqlite:///./data/ukmc.db

# ---------------------------------------------------------------------------
# Fixture mode (works with no credentials)
# ---------------------------------------------------------------------------
# When true the ingestion layer uses data/raw local fixtures instead of
# calling the TrueLayer Sandbox API.
UKMC_FIXTURE_MODE=true

# ---------------------------------------------------------------------------
# TrueLayer Data API Sandbox (only needed when UKMC_FIXTURE_MODE=false)
# Obtain sandbox credentials from https://console.truelayer.com/
# ---------------------------------------------------------------------------
UKMC_TRUELAYER_CLIENT_ID=
UKMC_TRUELAYER_CLIENT_SECRET=
UKMC_TRUELAYER_REDIRECT_URI=
UKMC_TRUELAYER_BANK_BASE_URL=https://api.truelayer-sandbox.com

# ---------------------------------------------------------------------------
# Model serving
# ---------------------------------------------------------------------------
# minilm | bilstm
UKMC_MODEL_TYPE=minilm
# Directory containing the saved inference artifact (defaults to artifacts/current)
UKMC_MODEL_DIR=artifacts/current
# cpu | cuda | mps | auto
UKMC_DEVICE=auto
# PyTorch random seed
UKMC_SEED=42

# ---------------------------------------------------------------------------
# PII redaction
# ---------------------------------------------------------------------------
# true: use the vendored UK-PII-Detector-Redactor (presidio + spaCy) engine.
# false: use the deterministic regex fallback only.
UKMC_PII_USE_PRESIDIO=true
